# PostgreSQL 密码必须在真实服务器上替换，不能继续使用示例值。
POSTGRES_PASSWORD=replace-with-a-random-password

# 公网部署时由 Caddy 使用该域名申请证书；阶段一默认仍监听 8088 HTTP。
AIOPS_PUBLIC_DOMAIN=localhost

# 不配置时插件安装和外部 Webhook 接口保持关闭；公网部署必须使用随机长令牌。
AIOPS_ADMIN_TOKEN=replace-with-a-random-admin-token

# 控制面使用该密钥签发 Agent 动作任务；建议使用 openssl rand -hex 32 生成。
# 两端必须完全相同，且至少 32 个字符，禁止与管理员令牌复用。
AIOPS_AGENT_SHARED_SECRET=replace-with-an-independent-32-byte-random-secret

# 仅供控制面调用实验 API 的内部故障开关，不得与其他令牌复用。
AIOPS_LAB_CONTROL_TOKEN=replace-with-an-independent-lab-control-token

# 真实资产默认只观察；approval_only 只能在完成至少 24 小时浸泡后人工启用。
AIOPS_REAL_ACTIONS_MODE=observe_only

# 轻量云部署由 compose.lite.yaml 打开 mTLS gRPC；基础实验 Compose 默认关闭。
AIOPS_AGENT_GRPC_ENABLED=false
